# ─────────────────────────────────────────────────────────────
#  Jarvis — environment configuration
#  Copy this file to `.env.local` and fill in the keys you have.
#  Everything works in DEMO mode with no keys at all.
# ─────────────────────────────────────────────────────────────

# Claude (the brain). Required for LIVE mode.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: the model Jarvis runs on (defaults to claude-opus-4-8)
# JARVIS_MODEL=claude-opus-4-8

# ElevenLabs (the rich British voice). Optional.
# When present, Jarvis speaks through ElevenLabs; otherwise he uses the
# browser's built-in en-GB voice.
# Get one at https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice id (defaults to a deep British male voice).
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
